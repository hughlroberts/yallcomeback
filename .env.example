# =============================================================================
# Yall Come Back — environment variables
# =============================================================================
# Copy to `.env` for local dev:  cp .env.example .env
#
# NEVER commit a real `.env` (or Railway secrets) to GitHub.
# Local: fill `.env` (gitignored via `.env*` + `!.env.example`)
# Railway: Project → Variables (or shared variables). Do not paste secrets into
#          source, README, or PRs.
# =============================================================================

# --- Database (Postgres required — Prisma provider is postgresql) ---
# DO NOT use file:./dev.db — schema is PostgreSQL only; SQLite URLs crash at runtime.
# Local: docker compose up -d  then use:
DATABASE_URL="postgresql://yall:yall@localhost:5432/yallcomeback?schema=public"
# Railway: add a Postgres plugin, then either:
#   - Reference ${{Postgres.DATABASE_URL}} in the web service variables, or
#   - Paste the Postgres connection string Railway shows (prefer the *internal*
#     URL when both services are on the same Railway project).

# --- Auth (Auth.js / NextAuth) ---
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-long-random-string"
# Public origin of this deployment (no trailing slash)
# Local: http://localhost:3000
# Production: https://www.yallcomeback.app
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Server Actions (stable IDs across deploys — prevents 409 "Server Action not found") ---
# Generate once with: openssl rand -base64 32. Must be identical on ALL builds/deploys.
# Set in Railway Variables (available at build time).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# --- Public site branding ---
NEXT_PUBLIC_SITE_NAME="Yall Come Back"
# Optional absolute origin for QR codes, emails, iCal (recommended in production)
# NEXT_PUBLIC_SITE_URL="https://www.yallcomeback.app"

# --- Custom host domains (comma-separated domain:hostSlug) ---
# Maps guest-facing domains to a host brand for multi-tenant routing.
# HOST_DOMAIN_MAP="cherokeelanding.net:cherokee-landing,www.cherokeelanding.net:cherokee-landing"
#
# Auto-provision host custom domains (SSL + DNS values shown in Brand).
# Account/API token with permission to manage service domains. Project /
# environment / service IDs are usually injected by the host platform at runtime.
# PLATFORM_DOMAIN_API_TOKEN=""
# Fallback names also accepted: RAILWAY_TOKEN or RAILWAY_API_TOKEN


# --- Stripe Connect (card deposits + hosting subscription) ---
# Self-host: create YOUR Stripe account. Do not copy keys from yallcomeback.app.
# Leave disabled until those keys exist. Never commit secrets.
STRIPE_ENABLED="false"
# Placeholder: sk_test_... from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Snapshot webhooks (Checkout, invoices, subscriptions): POST /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""
# Thin v2 Connect events: POST /api/stripe/thin-webhook
# stripe listen --thin-events 'v2.core.account[requirements].updated,v2.core.account[configuration.merchant].capability_status_updated,v2.core.account[configuration.customer].capability_status_updated' --forward-thin-to localhost:3000/api/stripe/thin-webhook
STRIPE_THIN_WEBHOOK_SECRET=""
# Recurring Price on the *platform* Stripe account (hosts pay YCB). Not Connect.
STRIPE_HOSTING_PRICE_ID=""
# YCB stay commission in cents. Keep 0 — not a processing-fee pass-through.
# Guest card charges are Direct Charges: Stripe bills the host, not YCB.
# Hosting / add-on invoices add a "Card processing" line so YCB nets the list price.
STRIPE_APPLICATION_FEE_CENTS="0"
# STRIPE_PERCENT_BPS="290"
# STRIPE_FIXED_FEE_CENTS="30"

# --- Bitcoin deposits (optional) ---
BITCOIN_ENABLED="false"
BITCOIN_ADDRESS=""
BITCOIN_NETWORK="mainnet"
BITCOIN_LABEL="Yall Come Back deposit"

# --- Messaging (in-app always on) ---
# Email: auto-on when FROM + transport (Resend key or SMTP) are set.
# Airbnb-style: always send from this Yall Come Back address. Stay mail rewrites
# the display name to "Host via Yall Come Back" and sets Reply-To to the host
# or guest. Never put a host Gmail/iCloud in FROM.
# Signup thanks/verify and forgot-password reset mail use this same FROM.
# Leave MESSAGING_EMAIL_ENABLED unset to auto-enable; set "false" to force off.
# MESSAGING_EMAIL_ENABLED="true"
MESSAGING_EMAIL_FROM=""
# Production: MESSAGING_EMAIL_FROM="Yall Come Back <bookings@yallcomeback.app>"
# Prefer Resend (https://resend.com) — also accepts RESEND_API_KEY
# RESEND_API_KEY=""
# MESSAGING_EMAIL_API_KEY=""
# MESSAGING_EMAIL_DRY_RUN="true"   # staging: log only, no send
# SMTP alternative (requires nodemailer):
# MESSAGING_SMTP_HOST=""
# MESSAGING_SMTP_PORT="587"
# MESSAGING_SMTP_USER=""
# MESSAGING_SMTP_PASS=""

# SMS: Twilio-ready, ops/product only — leave off until full product launch
MESSAGING_SMS_ENABLED="false"
MESSAGING_SMS_FROM=""
MESSAGING_SMS_ACCOUNT_SID=""
MESSAGING_SMS_PROVIDER_KEY=""
MESSAGING_SMS_DRY_RUN="true"

# --- Cron / automation ---
# The server runs iCal sync, booking messages, hosting payments, the daily
# backup, and monthly pricing inside the process. There is no public cron URL.
# First-party analytics stats API (GET /api/admin/stats). Bearer required.
# Generate: openssl rand -hex 32. Never commit the live value.
ANALYTICS_API_TOKEN="replace-with-random-string"
# In-process scheduler (instrumentation.ts): runs iCal sync + booking messages
# on the Node server. Default ON in production, OFF in dev.
# CRON_IN_PROCESS="true"
# Interval between runs (ms). Default 20 minutes; minimum 5 minutes.
# CRON_INTERVAL_MS="1200000"
#
# Daily full backup: directory for gzipped dumps (Railway volume).
# Production: attach a volume at /data/backups and set:
# BACKUP_DIR="/data/backups"

# --- Hosted platform product (NOT for MIT open-source self-host) ---
# Agent API, listing import, iCal setup agent, and pricing intelligence are paid YCB only.
# Leave these unset on a self-host copy.
# PLATFORM_PRODUCT_MODE="true"
# AGENT_API_ENABLED="true"
# POST /api/v1/stays/checkout is public (no token); it is rate limited per IP.
# AGENT_API_TOKEN is no longer read and can be left unset.
# Optional second signing secret when Stripe "Connected accounts" events use a separate
# webhook destination pointing at /api/stripe/webhook:
# STRIPE_CONNECT_WEBHOOK_SECRET=""
# LISTING_IMPORT_AGENT_ENABLED="true"
# ICAL_SETUP_AGENT_ENABLED="true"
# PRICING_INTELLIGENCE_ENABLED="true"
# YCB_OPEN_SOURCE_BUILD="true"
# Optional LLM brief for pricing research (xAI Grok or OpenAI-compatible)
# XAI_API_KEY=""
# PRICING_INTELLIGENCE_MODEL="grok-4-1-fast-non-reasoning"
# Monthly pricing runs on the in-process scheduler. A host with a completed
# run in the last 28 days is skipped.

# --- Node ---
# NODE_ENV="production"   # set by Railway/host automatically in most setups
