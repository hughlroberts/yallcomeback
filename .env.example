# =============================================================================
# Yall Come Back — environment variables
# =============================================================================
# Copy to `.env` for local dev:  cp .env.example .env
#
# NEVER commit a real `.env` (or Railway secrets) to GitHub.
# Local: fill `.env` (gitignored via `.env*` + `!.env.example`)
# Railway: Project → Variables (or shared variables). Do not paste secrets into
#          source, README, or PRs.
# =============================================================================

# --- Database (Postgres required — Prisma provider is postgresql) ---
# Local: docker compose up -d  then use:
DATABASE_URL="postgresql://yall:yall@localhost:5432/yallcomeback?schema=public"
# Railway: add a Postgres plugin, then either:
#   - Reference ${{Postgres.DATABASE_URL}} in the web service variables, or
#   - Paste the Postgres connection string Railway shows (prefer the *internal*
#     URL when both services are on the same Railway project).

# --- Auth (Auth.js / NextAuth) ---
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-long-random-string"
# Public origin of this deployment (no trailing slash)
# Local: http://localhost:3000
# Railway: https://your-app.up.railway.app  (or custom domain)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Public site branding ---
NEXT_PUBLIC_SITE_NAME="Yall Come Back"
# Optional absolute origin for QR codes, emails, iCal (recommended in production)
# NEXT_PUBLIC_SITE_URL="https://yallcomeback.com"

# --- Stripe (optional; leave disabled for manual deposits/invoices) ---
STRIPE_ENABLED="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Webhook path when live: POST /api/stripe/webhook

# --- Bitcoin deposits (optional) ---
BITCOIN_ENABLED="false"
BITCOIN_ADDRESS=""
BITCOIN_NETWORK="mainnet"
BITCOIN_LABEL="Yall Come Back deposit"

# --- Messaging (in-app always on; SMS/email optional) ---
MESSAGING_SMS_ENABLED="false"
MESSAGING_SMS_FROM=""
MESSAGING_SMS_PROVIDER_KEY=""
MESSAGING_SMS_DRY_RUN="true"
MESSAGING_EMAIL_ENABLED="false"
MESSAGING_EMAIL_FROM=""
MESSAGING_EMAIL_DRY_RUN="true"

# --- Cron / automation (optional; protect with a secret header) ---
# CRON_SECRET="replace-with-random-string"

# --- Node ---
# NODE_ENV="production"   # set by Railway/host automatically in most setups
