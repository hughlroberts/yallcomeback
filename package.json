{
  "name": "yallcomeback",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Open-source vacation rentals: host sites, marketplace, calendars, bookings.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-bookings": "tsx prisma/seed-sample-bookings.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "admin:ensure": "tsx scripts/ensure-platform-admin.ts",
    "provision:cherokee": "tsx scripts/provision-cherokee-paid.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:restore": "tsx scripts/restore-backup.ts",
    "postinstall": "prisma generate --schema=prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.25.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "happy-dom": "^21.0.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@auth/core": "0.41.3",
    "deepmerge-ts": "8.0.2",
    "nanoid": "3.3.18",
    "source-map-js": "1.2.2"
  }
}
